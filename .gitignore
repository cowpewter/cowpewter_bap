# Track only the pack's authored content: docs/, tools/, kubejs/ and config/.
# Everything else in minecraft/ (mods, saves, logs, caches) is ignored.
/*
!/.gitignore
!/docs/
!/tools/
__pycache__/
# Extracted from the FD jar by tools/extract_fd_recipes.py
/tools/fd_recipes/
!/kubejs/
!/config/

# Shipped shader: track only its Modrinth metadata (the zip is downloaded by
# the .mrpack). Solas/Unbound are local-only.
!/shaderpacks/
/shaderpacks/*
!/shaderpacks/complementary-reimagined.pw.toml

# Generated password for Resourceful Config's (disabled) web editor
/config/resourceful-config-web.json
# KubeJS web server auth token
/kubejs/config/web_server.json
# Per-world JEI lookup history (named after local test worlds)
/config/jei/world/

# Mod-written backups
*_backup[0-9]*

# Editor cruft
*.kate-swp
